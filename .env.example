# Public origin of the site, without trailing slash. Used for canonical URLs, hreflang and sitemap.xml.
NEXT_PUBLIC_SITE_URL=
# Contact address shown on the demo and contact pages. Leave empty to hide it.
NEXT_PUBLIC_CONTACT_EMAIL=
# Booking page embedded on the demo page (Calendly, Cal.com, ...). Leave empty to show the form only.
NEXT_PUBLIC_BOOKING_URL=
# Server-side endpoint that receives demo requests as JSON (CRM, automation tool, back-office).
DEMO_WEBHOOK_URL=
