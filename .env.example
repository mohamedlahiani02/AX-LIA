# Public origin of the site, without trailing slash. Used for canonical URLs, hreflang and sitemap.xml.
NEXT_PUBLIC_SITE_URL=
# Contact address shown on the demo and contact pages. Leave empty to hide it.
NEXT_PUBLIC_CONTACT_EMAIL=
# Server-only Resend API key. Never use a NEXT_PUBLIC_ prefix.
RESEND_API_KEY=
# Sender on a domain verified in Resend.
DEMO_EMAIL_FROM=AXELIA <contact@axelia.software>
# Inbox that receives demo submissions.
DEMO_EMAIL_TO=sales.axelia@outlook.com
